# Modèle du fichier .env : copier ce fichier en .env, puis renseigner les valeurs.
# Le fichier .env contient les vrais secrets : il ne doit JAMAIS être versionné.

# Clé API Mistral (https://console.mistral.ai/)
MISTRAL_API_KEY=

# Jeton qui autorise la reconstruction de l'index par l'API (POST /rebuild, en-tête X-Rebuild-Token).
# Laisser vide pour désactiver /rebuild. Choisir une valeur longue et aléatoire, par exemple :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
REBUILD_TOKEN=
